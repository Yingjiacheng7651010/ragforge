# ragforge 环境变量模板：复制为 .env 后填写真实值。
# 所有变量以 RAGFORGE_ 为前缀；留空的变量会被忽略（使用代码内默认值），
# 必填项未填写时启动配置校验会报错。

# --- LLM（必填）---
RAGFORGE_LLM_PROVIDER=
RAGFORGE_LLM_MODEL=
RAGFORGE_LLM_API_KEY=
# fallback 链，JSON 数组，如 ["anthropic","deepseek"]；默认空列表
RAGFORGE_LLM_FALLBACK_CHAIN=

# --- Embedding / Reranker（必填）---
RAGFORGE_EMBEDDING_MODEL=
RAGFORGE_EMBEDDING_DIM=
RAGFORGE_RERANKER_MODEL=

# --- Retrieval（可选，默认值见注释）---
# 默认 50
RAGFORGE_RETRIEVAL_TOP_K=
# 默认 8
RAGFORGE_RERANK_TOP_N=
# 默认 60
RAGFORGE_RRF_K=

# --- Semantic cache（可选）---
# 默认 true
RAGFORGE_SEMANTIC_CACHE_ENABLED=
# 默认 0.92
RAGFORGE_SEMANTIC_CACHE_THRESHOLD=

# --- Observability（可选）---
RAGFORGE_OTEL_ENDPOINT=
